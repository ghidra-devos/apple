; SERP executable header, 80 bytes, written by fasm through apps/runtime/program.inc or by
; apple directly. code is loaded at USER_CODE_ADDRESS, bss follows it, zeroed

SERP_MAGIC = 0x53525045

SERP_VERSION = 1

SERP_FLAG_USER = 1
SERP_FLAG_GUI = 2
SERP_FLAG_SYSTEM = 4
SERP_FLAG_DEBUG = 8

SERP_HEADER_MAGIC = 0
SERP_HEADER_VERSION = 4
SERP_HEADER_FLAGS = 6
SERP_HEADER_HEADER_SIZE = 8
SERP_HEADER_ENTRY = 16
SERP_HEADER_CODE_OFFSET = 24
SERP_HEADER_CODE_SIZE = 32
SERP_HEADER_DATA_OFFSET = 40
SERP_HEADER_DATA_SIZE = 48
SERP_HEADER_BSS_SIZE = 56
SERP_HEADER_STACK_SIZE = 64
SERP_HEADER_REQUIRED_PAGES = 72  ; 0 or the code pages, only a sanity check
SERP_HEADER_SIZE = 80
